{
  "name": "tv-analytics-sdk-js",
  "version": "1.0.0",
  "description": "Cross-platform analytics client SDK for JavaScript & TypeScript (Web, Node.js, Bun, Mobile Web)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cho-game/tv-analytics-sdk-js.git"
  },
  "homepage": "https://github.com/cho-game/tv-analytics-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/cho-game/tv-analytics-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:types && bun run build:bundle",
    "build:bundle": "bun build --outfile=dist/index.js --format=esm ./src/index.ts && bun build --outfile=dist/index.cjs --format=cjs ./src/index.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun test && bun run build"
  },
  "keywords": [
    "analytics",
    "sdk",
    "game-analytics",
    "typescript",
    "bun",
    "browser",
    "events",
    "tracking"
  ],
  "author": "antn9x",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0"
  }
}
